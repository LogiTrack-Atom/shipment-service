{
  "info": {
    "name": "LogiTrack Sprint03 — Seguridad y negocio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requiere security_fixture.py sobre una demo propia. Cubre JWT vencido con firma válida, roles/pertenencia y errores de negocio. Cada rechazo termina con lecturas y comparación de envío e historial. El generador prepara un envío auxiliar CANCELADO sin modificar los envíos de referencia. Restablecer la demo al terminar."
  },
  "item": [
    {
      "name": "Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{securityBaseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.variables.set(\"adminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
