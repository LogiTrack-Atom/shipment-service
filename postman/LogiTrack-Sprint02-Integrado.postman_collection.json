        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.variables.set(\"clienteToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Alta usuario REPARTIDOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{securityBaseUrl}}/api/v1/usuarios",
          "host": [
            "{{securityBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{repartidorEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"rol\": \"REPARTIDOR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.variables.set(\"usuarioRepartidorId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
