          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tres eventos\", () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Acceso anónimo rechazado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
