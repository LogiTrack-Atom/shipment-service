              "pm.variables.set(\"repartidorId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Vincular identidad en courier",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
