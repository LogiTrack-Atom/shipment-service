{
  "info": {
    "name": "LogiTrack Sprint02 — Flujo integrado",
    "description": "Ejecutar en orden contra un entorno aislado. Requiere ADMIN existente y credenciales externas. Crea usuarios/repartidor/envío de prueba; no borra datos. Tokens y UUID se conservan solo como variables locales de la ejecución. No exportar sesiones con secretos. La colección de regresión Sprint02 complementa este flujo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get(\"clienteEmail\")) {",
          "  const suffix = pm.variables.replaceIn(\"{{$guid}}\");",
          "  pm.variables.set(\"clienteEmail\", \"cliente-\" + suffix + \"@ensayo.example\");",
          "  pm.variables.set(\"repartidorEmail\", \"repartidor-\" + suffix + \"@ensayo.example\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{securityBaseUrl}}/api/v1/auth/login",
          "host": [
            "{{securityBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.variables.set(\"adminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registro CLIENTE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{securityBaseUrl}}/api/v1/auth/register",
          "host": [
            "{{securityBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Registro público CLIENTE\", () => pm.expect(pm.response.json().roles).to.eql([\"CLIENTE\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Login CLIENTE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
