          }
        ],
        "url": {
          "raw": "{{courierBaseUrl}}/api/v1/repartidores/{{repartidorId}}/usuario",
          "host": [
            "{{courierBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "repartidores",
            "{{repartidorId}}",
            "usuario"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": \"{{usuarioRepartidorId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
