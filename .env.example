# Copiar a ".env" (cp .env.example .env) y completar. NO subir ".env" al repositorio.

# --- MySQL ---
MYSQL_DATABASE=shipment_db
MYSQL_USER=shipment_user
MYSQL_PASSWORD=cambiar_password
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_HOST_PORT=3307

# --- Aplicación ---
APP_PORT=8080
# El SQL inicial crea el esquema; Hibernate verifica su correspondencia con JPA.
JPA_DDL_AUTO=validate
TZ=UTC