# Copiar a un archivo privado y completar; no versionar secretos.
COMPOSE_PROJECT_NAME=logitrack-sprint02
SPRING_PROFILES_ACTIVE=dev
# Commit verificado de configserver-ms; usar una revisión fija para reproducir.
CONFIG_LABEL=b40bd4d0eecd5eff6e5ef0a7b23d0a106a39ba13
# Versiones explícitas de las imágenes de entrega.
SHIPMENT_IMAGE=maxdz10/shipment-service:sprint02-1.0.0
COURIER_IMAGE=maxdz10/courier-service:sprint02-1.0.0
SECURITY_IMAGE=maxdz10/security-service:sprint02-1.0.0
CONFIGSERVER_IMAGE=maxdz10/configserver:sprint02-1.0.0
SHIPMENT_DB_PASSWORD=
SHIPMENT_DB_ROOT_PASSWORD=
COURIER_DB_PASSWORD=
COURIER_DB_ROOT_PASSWORD=
SECURITY_DB_PASSWORD=
SECURITY_DB_ROOT_PASSWORD=
# Grupo externo de las claves (id -g); el proceso sigue como UID 10001.
KEYS_GID=
# Archivos externos legibles por ese grupo; solo security recibe la privada.
JWT_PUBLIC_KEY_FILE=/ruta/externa/public.pem
JWT_PRIVATE_KEY_FILE=/ruta/externa/private.pem
# Habilitar solo para aprovisionar ADMIN en el primer arranque; luego deshabilitar.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SHIPMENT_HOST_PORT=8080
COURIER_HOST_PORT=8081
SECURITY_HOST_PORT=8082
CONFIG_SERVER_HOST_PORT=8085
