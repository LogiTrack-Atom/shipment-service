{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LogiTrack-Atom/shipment-service/blob/develop/docs/sprint04/asignacion-asincrona/operation.schema.json",
  "title": "operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "envioId",
    "repartidorId",
    "assignmentVersion",
    "status",
    "reason",
    "createdAt",
    "updatedAt",
    "expiresAt"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "envioId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repartidorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignmentVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "PENDING",
        "APPLIED",
        "REJECTED",
        "SUPERSEDED",
        "EXPIRED"
      ]
    },
    "reason": {
      "enum": [
        null,
        "INACTIVE",
        "NOT_FOUND",
        "STATE_CHANGED",
        "REPLACED",
        "DEADLINE_EXCEEDED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "INACTIVE",
              "NOT_FOUND"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "STATE_CHANGED",
              "REPLACED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXPIRED"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "DEADLINE_EXCEEDED"
            ]
          }
        }
      }
    }
  ]
}
