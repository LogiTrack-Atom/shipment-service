# Preparación #44: copiar fuera de Git y completar tras publicar/verificar las imágenes.
COMPOSE_PROJECT_NAME=logitrack-sprint03
SPRING_PROFILES_ACTIVE=dev
# SHA de 40 caracteres de configserver-ms que incluya Eureka, Gateway y descubrimiento.
CONFIG_LABEL=
# Referencias publicadas con versión explícita o digest. No usar imágenes antiguas de dominio.
CONFIGSERVER_IMAGE=
EUREKA_IMAGE=
SECURITY_IMAGE=
COURIER_IMAGE=
SHIPMENT_IMAGE=
GATEWAY_IMAGE=
SHIPMENT_DB_PASSWORD=
SHIPMENT_DB_ROOT_PASSWORD=
COURIER_DB_PASSWORD=
COURIER_DB_ROOT_PASSWORD=
SECURITY_DB_PASSWORD=
SECURITY_DB_ROOT_PASSWORD=
# Archivos externos 0640 y grupo con lectura (id -g). Privada exclusivamente para security.
KEYS_GID=
JWT_PUBLIC_KEY_FILE=/ruta/externa/public.pem
JWT_PRIVATE_KEY_FILE=/ruta/externa/private.pem
# Activar solo para el primer ADMIN; luego desactivar conservando su base.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
GATEWAY_HOST_PORT=8066
# Solo se utilizan si se agrega compose.sprint03.diagnostics.yaml.
CONFIG_SERVER_HOST_PORT=8085
EUREKA_HOST_PORT=8065
SECURITY_HOST_PORT=8082
COURIER_HOST_PORT=8081
SHIPMENT_HOST_PORT=8080
