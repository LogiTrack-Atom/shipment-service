# Preparación #44: copiar fuera de Git y completar tras publicar/verificar las imágenes.
COMPOSE_PROJECT_NAME=logitrack-sprint03
SPRING_PROFILES_ACTIVE=dev
# SHA de 40 caracteres de configserver-ms que incluya Eureka, Gateway y descubrimiento.
CONFIG_LABEL=a08f95ee8fa0bf412fb30f68776e9a8794f94110
# Referencias publicadas con versión explícita o digest. No usar imágenes antiguas de dominio.
CONFIGSERVER_IMAGE=maxdz10/configserver:sprint02-1.0.0@sha256:1658bc0e413f5519087ab00ef0e170de31cb20a17b6b84aef08ca17acf19874b
EUREKA_IMAGE=maxdz10/eureka-server:sprint03-1.0.0@sha256:70a31b326a036de44fcd57238b3bf65f9f1a26e11735108cce1e944fea9dcdcb
SECURITY_IMAGE=maxdz10/security-service:sprint03-1.0.0@sha256:12353ae6ff6cdafc5f3b27de40da66587e5eaee893664a732e1a828e2c8095b8
COURIER_IMAGE=maxdz10/courier-service:sprint03-1.0.0@sha256:a226ba795cea75de3343db6b5a0a0a053b36262c7b6c1290e485e55c6e4abf3f
SHIPMENT_IMAGE=maxdz10/shipment-service:sprint03-1.0.0@sha256:aa85d72dbb97bf0cc6c1c81d261fa892f312db922cee21e6cee086a8d4f81595
GATEWAY_IMAGE=maxdz10/api-gateway:sprint03-1.0.0@sha256:5c9496b6311b60f88382785093175ba92255a405f7a1036b8f1843f4e33663cf
SHIPMENT_DB_PASSWORD=
SHIPMENT_DB_ROOT_PASSWORD=
COURIER_DB_PASSWORD=
COURIER_DB_ROOT_PASSWORD=
SECURITY_DB_PASSWORD=
SECURITY_DB_ROOT_PASSWORD=
# Archivos externos 0640 y grupo con lectura (id -g). Privada exclusivamente para security.
KEYS_GID=
JWT_PUBLIC_KEY_FILE=/ruta/externa/public.pem
JWT_PRIVATE_KEY_FILE=/ruta/externa/private.pem
# Activar solo para el primer ADMIN; luego desactivar conservando su base.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
GATEWAY_HOST_PORT=8066
# Solo se utilizan si se agrega compose.sprint03.diagnostics.yaml.
CONFIG_SERVER_HOST_PORT=8085
EUREKA_HOST_PORT=8065
SECURITY_HOST_PORT=8082
COURIER_HOST_PORT=8081
SHIPMENT_HOST_PORT=8080
